@using TicketApp.Models
@using TicketApp.Data
@using Microsoft.AspNetCore.Components.Authorization
@inject TicketRepository Repo
@inject IWebHostEnvironment Env
@inject IConfiguration Config
@inject AuthenticationStateProvider AuthStateProvider

@if (IsVisible && Ticket != null)
{
    <div class="modal-backdrop">
        <div class="modal-content">
            <div class="modal-header">
                <h2>Ticket @Ticket.Folio - @Ticket.Asunto</h2>
                <button class="close-btn" @onclick="CerrarModal">X</button>
            </div>
            
            <div class="modal-body">
                <p><strong>Solicitante:</strong> @Ticket.Nombre (<a href="mailto:@Ticket.Correo">@Ticket.Correo</a>)</p>
                @if(!string.IsNullOrEmpty(Ticket.Telefono)){
                    <p><strong>Teléfono:</strong> @Ticket.Telefono</p>
                }
                <p><strong>Fecha de Reporte:</strong> @Ticket.FechaCreacion.ToString("g")</p>
                @if (!string.IsNullOrEmpty(Ticket.ResueltoPor))
                {
                    <p><strong>Resuelto por:</strong> <span class="badge resuelto">@Ticket.ResueltoPor</span></p>
                }
                
                <p><strong>Descripción del Problema:</strong></p>
                <div class="ticket-desc">@Ticket.Descripcion</div>
                
                <hr />
                <h4>Archivos Adjuntos (Usuario)</h4>
                @if(!Archivos.Any(a => !a.EsEvidenciaSoporte)) { <p><small>Sin archivos adjuntos.</small></p> }
                <ul>
                    @foreach(var arc in Archivos.Where(a => !a.EsEvidenciaSoporte))
                    {
                        <li><a href="/api/files/@arc.Id" target="_blank">@arc.NombreOriginal</a></li>
                    }
                </ul>

                <h4>Evidencia de Soporte (Auditoría)</h4>
                @if(!Archivos.Any(a => a.EsEvidenciaSoporte)) { <p><small>Aún no hay evidencia del equipo de soporte.</small></p> }
                <ul>
                    @foreach(var arc in Archivos.Where(a => a.EsEvidenciaSoporte))
                    {
                        <li><a href="/api/files/@arc.Id" target="_blank">@arc.NombreOriginal</a></li>
                    }
                </ul>
                <hr />
                <h4>Bitácora de Soporte</h4>
                <div class="comentarios-lista" style="max-height: 150px; overflow-y: auto; margin-bottom: 1rem; background: #f8fafc; padding: 1rem; border-radius: 4px; border: 1px solid var(--border);">
                    @if (Comentarios == null || !Comentarios.Any())
                    {
                        <p style="color: #64748b; font-size: 0.9em; margin: 0;">No hay comentarios aún.</p>
                    }
                    else
                    {
                        @foreach(var c in Comentarios)
                        {
                            <div style="margin-bottom: 0.5rem; border-bottom: 1px solid #e2e8f0; padding-bottom: 0.5rem;">
                                <strong style="font-size: 0.85em; color: var(--primary);">@c.Autor - @c.Fecha.ToString("g")</strong>
                                <p style="margin: 0.2rem 0; font-size: 0.95em;">@c.Texto</p>
                            </div>
                        }
                    }
                </div>

                <div class="form-group" style="display: flex; gap: 0.5rem;">
                    <input type="text" @bind="nuevoComentario" class="input-control" placeholder="Escribe un comentario o nota de resolución..." />
                    <button class="btn secondary" type="button" @onclick="GuardarComentario">Agregar</button>
                </div>
                <hr />
                <div class="form-group">
                    <label>Cambiar Estatus del Ticket:</label>
                    <select class="input-control" @bind="Ticket.Estatus">
                        <option value="Abierto">Abierto</option>
                        <option value="En Progreso">En Progreso</option>
                        <option value="Resuelto">Resuelto</option>
                    </select>
                </div>
                
                <div class="form-group">
                    <label>Añadir Evidencia de Resolución (Max 3 archivos, 5MB c/u):</label>
                    <InputFile OnChange="SubirEvidenciaSoporte" multiple accept=".jpg,.png,.webp,.pdf" class="input-control" />
                    @if(!string.IsNullOrEmpty(ErrorEvidencia)){ <div style="color:red; font-size: 0.85em; margin-top: 5px; font-weight: 500;">@ErrorEvidencia</div> }
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn secondary" @onclick="CerrarModal">Cancelar</button>
                <button class="btn primary" @onclick="GuardarCambios">Guardar Cambios</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public Ticket? Ticket { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    
    private List<ArchivoAdjunto> Archivos = new();
    private List<ComentarioTicket> Comentarios = new();
    private string nuevoComentario = "";
    
    private string ErrorEvidencia = "";
    private IReadOnlyList<IBrowserFile>? archivosEvidencia;

    protected override async Task OnParametersSetAsync()
    {
        if (IsVisible && Ticket != null)
        {
            var res = await Repo.ObtenerArchivosPorTicketAsync(Ticket.Id);
            Archivos = res.ToList();
            var resComentarios = await Repo.ObtenerComentariosAsync(Ticket.Id);
            Comentarios = resComentarios.ToList();
        }
    }

    private void SubirEvidenciaSoporte(InputFileChangeEventArgs e)
    {
        ErrorEvidencia = ""; 
        archivosEvidencia = null;

        if (e.FileCount > 3)
        {
            ErrorEvidencia = "Máximo 3 archivos permitidos.";
            return;
        }

        var files = e.GetMultipleFiles(3); 

        foreach (var file in files)
        {
            if (file.Size > 5 * 1024 * 1024)
            {
                ErrorEvidencia = $"El archivo {file.Name} supera los 5 MB.";
                return;
            }
        }
        
        archivosEvidencia = files;
    }

    private async Task GuardarCambios()
    {
        if (Ticket == null) return;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var currentUser = authState.User.Identity?.Name;

        await Repo.ActualizarEstatusTicketAsync(Ticket.Id, Ticket.Estatus, currentUser);

        if (archivosEvidencia != null && archivosEvidencia.Any())
        {
            try
            {
                var relativePath = Config["FileStorage:AttachmentsPath"] ?? "App_Data/Attachments";
                var uploadPath = Path.Combine(Env.ContentRootPath, relativePath);
                Directory.CreateDirectory(uploadPath);

                foreach (var file in archivosEvidencia)
                {
                    var fileName = Guid.NewGuid().ToString() + Path.GetExtension(file.Name);
                    var filePath = Path.Combine(uploadPath, fileName);

                    await using FileStream fs = new(filePath, FileMode.Create);
                    await file.OpenReadStream(5 * 1024 * 1024).CopyToAsync(fs);

                    await Repo.GuardarArchivoAsync(new ArchivoAdjunto
                    {
                        TicketId = Ticket.Id,
                        NombreOriginal = file.Name,
                        RutaAlmacenamiento = filePath,
                        ContentType = file.ContentType,
                        EsEvidenciaSoporte = true
                    });
                }
                archivosEvidencia = null; 
            }
            catch (Exception ex)
            {
                ErrorEvidencia = "Error al guardar: " + ex.Message;
                return; 
            }
        }

        await OnClose.InvokeAsync();
    }

    private async Task GuardarComentario()
    {
        if (string.IsNullOrWhiteSpace(nuevoComentario) || Ticket == null) return;
    
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var currentUser = authState.User.Identity?.Name ?? "Soporte";
        await Repo.AgregarComentarioAsync(new ComentarioTicket 
        { 
            TicketId = Ticket.Id, 
            Texto = nuevoComentario,
            Autor = currentUser 
        });
        nuevoComentario = ""; 
    
        var res = await Repo.ObtenerComentariosAsync(Ticket.Id);
        Comentarios = res.ToList();
    }

    private Task CerrarModal() 
    {
        archivosEvidencia = null;
        ErrorEvidencia = "";
        return OnClose.InvokeAsync();
    }
}